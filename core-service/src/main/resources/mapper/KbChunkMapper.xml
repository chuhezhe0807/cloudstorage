<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chuhezhe.core.kb.mapper.KbChunkMapper">

    <select id="searchTopK" resultMap="kbcDefaultResultMap" parameterType="map">
        SELECT id, tenant_id, kb_id, file_id, chunk_index, content, embedding, metadata, created_at
        FROM kb_chunk
        WHERE kb_id = #{kbId}
          AND embedding IS NOT NULL
        ORDER BY embedding &lt;=&gt; CAST(#{queryVector} AS vector)
        LIMIT #{k}
    </select>

    <resultMap id="kbcDefaultResultMap" type="com.chuhezhe.core.kb.entity.KbChunk">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="kb_id" property="kbId"/>
        <result column="file_id" property="fileId"/>
        <result column="chunk_index" property="chunkIndex"/>
        <result column="content" property="content"/>
        <result column="embedding" property="embedding" typeHandler="com.chuhezhe.common.handler.VectorTypeHandler"/>
        <result column="metadata" property="metadata"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

</mapper>
